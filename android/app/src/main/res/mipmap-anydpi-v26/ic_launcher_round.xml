<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks every icon to the launcher's own shape. Without this pair
     the square icon gets a white plate stamped behind it, which on a dark icon
     reads as a mistake. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/hexcapeBackground" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
