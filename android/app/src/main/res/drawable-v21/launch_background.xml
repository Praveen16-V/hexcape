<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window, shown until Flutter draws its first frame.

     The template painted this white, which meant a dark game flashed white on
     every cold start on a light-mode device. It is the game's own background
     colour now, so the launch is a fade from the right colour rather than a
     blink. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/hexcapeBackground" />
</layer-list>
