<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Both themes are dark regardless of the device's light/dark setting.
         The game itself has no light mode, so following the system here would
         only ever mean flashing a colour the app never uses. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/hexcapeBackground</item>
    </style>
</resources>
